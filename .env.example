# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Frontend: production — use same URL as the deployed site (Vercel serverless + rewrites).
# Set to true on Vercel so login hits /api/admin/login on your domain (not dynamicpricing API).
# VITE_SAME_ORIGIN_API=true

# Or set explicit origin (overrides same-origin): https://your-app.vercel.app
# VITE_API_BASE_URL=

# Server (server.ts): proxies /api to this upstream unless USE_LOCAL_API_MOCK=true.
# Defaults to https://dynamicpricing-api.dynamicpricingbuilder.com if unset.
API_BASE_URL=""

# Server: set to "true" to use built-in mock APIs instead of proxying upstream.
USE_LOCAL_API_MOCK=false
