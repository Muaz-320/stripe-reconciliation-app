# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://dynamicpricing-api.dynamicpricingbuilder.com"

# Frontend (Vite): production build calls this API origin. Dev uses same-origin /api.
# Example: https://dynamicpricing-api.dynamicpricingbuilder.com
VITE_API_BASE_URL="https://dynamicpricing-api.dynamicpricingbuilder.com"

# Server (server.ts): proxies /api to this upstream unless USE_LOCAL_API_MOCK=true.
# Defaults to https://dynamicpricing-api.dynamicpricingbuilder.com if unset.
API_BASE_URL="https://dynamicpricing-api.dynamicpricingbuilder.com"

# Server: set to "true" to use built-in mock APIs instead of proxying upstream.
USE_LOCAL_API_MOCK=false
